arch "Synthetic system, 36 nodes"

group g0 "Domain 0"
  n0_0 "Service 0.0" "pkg/n0_0" :queue plan
  n0_1 "Service 0.1" "pkg/n0_1" :store done
  n0_2 "Service 0.2" "pkg/n0_2"
  n0_3 "Service 0.3" "pkg/n0_3"
  n0_4 "Service 0.4" "pkg/n0_4" done
  n0_5 "Service 0.5" "pkg/n0_5" :store wip
group g1 "Domain 1"
  n1_0 "Service 1.0" "pkg/n1_0" done
  n1_1 "Service 1.1" "pkg/n1_1"
  n1_2 "Service 1.2" "pkg/n1_2" done
  n1_3 "Service 1.3" "pkg/n1_3" done
  n1_4 "Service 1.4" "pkg/n1_4" :queue done
  n1_5 "Service 1.5" "pkg/n1_5" :store plan
group g2 "Domain 2"
  n2_0 "Service 2.0" "pkg/n2_0" :store done
  n2_1 "Service 2.1" "pkg/n2_1" :store
  n2_2 "Service 2.2" "pkg/n2_2" :store done
  n2_3 "Service 2.3" "pkg/n2_3" done
  n2_4 "Service 2.4" "pkg/n2_4" :store
  n2_5 "Service 2.5" "pkg/n2_5" :store done
group g3 "Domain 3"
  n3_0 "Service 3.0" "pkg/n3_0" :store plan
  n3_1 "Service 3.1" "pkg/n3_1" wip
  n3_2 "Service 3.2" "pkg/n3_2" done
  n3_3 "Service 3.3" "pkg/n3_3" done
  n3_4 "Service 3.4" "pkg/n3_4" :store
  n3_5 "Service 3.5" "pkg/n3_5" wip
group g4 "Domain 4"
  n4_0 "Service 4.0" "pkg/n4_0" wip
  n4_1 "Service 4.1" "pkg/n4_1" :store done
  n4_2 "Service 4.2" "pkg/n4_2"
  n4_3 "Service 4.3" "pkg/n4_3" done
  n4_4 "Service 4.4" "pkg/n4_4" wip
  n4_5 "Service 4.5" "pkg/n4_5" :queue plan
group g5 "Domain 5"
  n5_0 "Service 5.0" "pkg/n5_0" plan
  n5_1 "Service 5.1" "pkg/n5_1" plan
  n5_2 "Service 5.2" "pkg/n5_2" :queue done
  n5_3 "Service 5.3" "pkg/n5_3" done
  n5_4 "Service 5.4" "pkg/n5_4" :queue wip
  n5_5 "Service 5.5" "pkg/n5_5"

n5_5 -> n1_0
n4_3 --> n5_5 "call 39" done
n2_1 -> n3_0 plan
n3_5 -> n4_3 plan
n4_2 -> n5_4 "call 15" wip
n4_5 --> n1_5 "call 70" plan
n3_1 -> n1_4 "call 16" done
n2_2 --> n1_2 "call 31"
n3_4 -> n4_0 "call 66" done
n5_5 -> n5_0 plan
n2_2 -> n3_4 wip
n1_5 --> n5_3 "call 16" done
n0_1 -> n5_3 "call 60"
n2_5 -> n0_0 done
n4_2 --> n5_1 done
n4_3 --> n0_4 done
n3_5 -> n1_5
n0_2 -> n5_0 "call 21" done
n5_3 -> n1_1 wip
n2_5 -> n3_4 "call 87"
n1_5 --> n3_3
n3_1 -> n4_2 "call 57" plan
n3_2 --> n4_5 "call 85"
n1_2 -> n5_3 "call 71" done
n5_0 --> n4_1 plan
n3_4 --> n0_4 done
n3_5 -> n2_1 "call 41" done
n5_0 -> n2_3 done
n4_0 -> n0_0 "call 19" wip
n2_1 -> n5_1
n2_1 -> n1_0 "call 77" wip
n4_4 -> n5_4 "call 59" done
n1_5 -> n2_3 done
n4_5 --> n2_3 "call 67"
n5_5 -> n0_3 done
n0_4 -> n5_1 "call 54" plan
n5_1 --> n1_0
n2_0 -> n0_0 "call 11"
n3_0 -> n2_3 "call 42"
n0_0 -> n1_1 "call 78" wip
n4_0 -> n4_1 "call 54"
n2_5 -> n5_1 wip
n5_3 --> n1_2 plan
n4_1 -> n5_2 wip
n1_0 -> n1_2 "call 48"
n5_2 --> n4_2 "call 27" done
n3_5 -> n3_4
n5_5 -> n2_2 plan
n5_0 --> n4_4 wip
